{
  "name": "palim",
  "version": "0.0.0",
  "description": "A lightweight, standards-compliant HTML and DOM implementation for JavaScript.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --root ../.. --config vitest.config.ts --project palim"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-ashula/palim.git"
  },
  "bugs": {
    "url": "https://github.com/t-ashula/palim/issues"
  },
  "homepage": "https://github.com/t-ashula/palim#readme",
  "dependencies": {
    "@palim/core": "0.0.0",
    "@palim/engine262": "0.0.0",
    "@palim/scripting": "0.0.0",
    "@palim/window": "0.0.0"
  }
}
