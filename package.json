{
  "name": "palim",
  "version": "0.0.0",
  "description": "A lightweight, standards-compliant HTML and DOM implementation for JavaScript.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.2.1",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "benchmark": "sh benchmark/run.sh",
    "benchmark:memory": "sh benchmark/run.sh memory",
    "benchmark:speed": "sh benchmark/run.sh speed",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run build",
    "conformance:sync": "sh tools/conformance/sync.sh",
    "conformance:sync:force": "sh tools/conformance/sync.sh --force",
    "conformance:test": "sh tools/conformance/run.sh",
    "format": "prettier --check --write .",
    "lint": "eslint . --fix",
    "test": "vitest run --project project",
    "test:watch": "vitest --project project",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-ashula/palim.git"
  },
  "bugs": {
    "url": "https://github.com/t-ashula/palim/issues"
  },
  "homepage": "https://github.com/t-ashula/palim#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
