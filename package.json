{
  "name": "palim-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/polyfills",
    "packages/core",
    "packages/window",
    "packages/scripting",
    "packages/engine262",
    "packages/palim"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "benchmark": "sh benchmark/run.sh",
    "benchmark:memory": "sh benchmark/run.sh memory",
    "benchmark:speed": "sh benchmark/run.sh speed",
    "build": "npm run build --workspaces",
    "build:wpt-report": "tsc -p tools/conformance/tsconfig.build.json",
    "check": "npm run format && npm run lint && npm run typecheck && npm test",
    "conformance:sync": "sh tools/conformance/sync.sh",
    "conformance:sync:force": "sh tools/conformance/sync.sh --force",
    "conformance:test": "sh tools/conformance/run.sh",
    "format": "prettier --check --write .",
    "lint": "eslint . --fix",
    "pretest": "npm run build",
    "test": "vitest run --project polyfills --project core --project window --project scripting --project engine262 --project palim --project integration --project tooling",
    "test:conformance": "vitest run --project conformance",
    "test:watch": "vitest --project polyfills --project core --project window --project scripting --project engine262 --project palim --project integration --project tooling",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wpt:test": "sh tools/wpt/run.sh",
    "wpt:test:full": "sh tools/wpt/run.sh --full"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-ashula/palim.git"
  },
  "bugs": {
    "url": "https://github.com/t-ashula/palim/issues"
  },
  "homepage": "https://github.com/t-ashula/palim#readme",
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
